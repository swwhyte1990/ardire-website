# Cache headers (honoured by Cloudflare Pages).
# Everything Vite emits to /assets/ is content-hashed, images included, so a
# changed file always arrives under a new URL and can be cached indefinitely.
# The few files below stay in public/ at fixed paths and so need a short TTL:
# favicon.svg is fetched by path regardless of the <link> tag, and opengraph.jpg
# is referenced by absolute URL in the social meta tags, where a hashed name would
# strand links people have already shared.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/opengraph.jpg
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
